# ==============================================================================
# Xianyu AutoAgent Pro 2.0 - 企业级生产环境配置清单 (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 大模型推理引擎配置 (兼容 OpenAI / DashScope 通义千问 / DeepSeek / Ollama)
# ------------------------------------------------------------------------------
API_KEY=sk-your_api_key_here
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max
# CLASSIFY_MODEL_NAME=qwen-plus  # 可选：轻量级意图分类模型，留空则复用主模型

# ------------------------------------------------------------------------------
# 2. 闲鱼店铺与账号凭据
# ------------------------------------------------------------------------------
# 从闲鱼网页端 (2.goofish.com) 复制抓取的完整 Cookie 字符串 (也可在 Web 工作台直接添加)
COOKIES_STR=

# ------------------------------------------------------------------------------
# 3. 数据库存储架构 (支持 SQLite 本地轻量模式 / PostgreSQL 18 企业级高并发集群)
# ------------------------------------------------------------------------------
# 方案 A: 默认 SQLite 零依赖极速模式 (本地直接 python run.py 启动推荐)
DATABASE_URL=sqlite+aiosqlite:///data/xianyu_v2.db

# 方案 B: PostgreSQL 18 企业级原生 AIO + 异步连接池模式 (Docker Compose 生产推荐)
# 提示: Docker 容器内使用 postgres 作为主机名，宿主机本地使用 localhost:5432
# DATABASE_URL=postgresql+asyncpg://xianyu:xianyu_secret_password@localhost:5432/xianyu_agent

# ------------------------------------------------------------------------------
# 4. 高速分布式缓存引擎 (Redis 8)
# ------------------------------------------------------------------------------
# 可选：留空则默认使用内置内存动态缓存与正则秒回引擎
# 启用 Redis 8 可获得跨进程高频问答秒级命中 (<2ms) 与分布式会话持久化
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. 人机协同与自动化决策策略
# ------------------------------------------------------------------------------
DEFAULT_COPILOT_MODE=auto       # 协同模式: auto(全托管) | draft(草稿待确认) | manual(全人工)
TOGGLE_KEYWORDS=。              # 卖家快捷输入接管/退回触发词
SIMULATE_HUMAN_TYPING=False    # 是否开启拟人随机打字延时 (防封防检测)
MESSAGE_DEBOUNCE_SECONDS=2.5   # 买家多句连发防抖聚合窗口时长 (秒)
MANUAL_MODE_TIMEOUT=3600       # 人工接管自动超时恢复托管时长 (秒)

# ------------------------------------------------------------------------------
# 6. 多渠道实时告警通知 (支持钉钉 / 飞书 / 企业微信 / iOS Bark)
# ------------------------------------------------------------------------------
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
BARK_URL=
NOTIFY_ON_ORDER=True
NOTIFY_ON_CAPTCHA=True
NOTIFY_ON_TAKEOVER=True

# ------------------------------------------------------------------------------
# 7. 控制台网络与服务网关
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
# PROXY_URL=http://127.0.0.1:7890  # 网络代理 (如 http/socks5，按需开启)
